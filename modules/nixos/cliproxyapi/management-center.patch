+import { expect, test } from 'bun:test';
+import { OPENCODE_GO_CONFIG, parseOpenCodeGoWindows } from '../src/features/quota/providers/opencodeGo/data';
+
+test('OpenCode Go usage produces three quota windows', () => {
+  const windows = parseOpenCodeGoWindows({
+    usage: {
+      rolling: { status: 'ok', percent: 12, resets_at: '2026-09-24T12:00:00Z' },
+      weekly: { status: 'ok', percent: 45, resets_at: '2026-09-30T12:00:00Z' },
+      monthly: { status: 'ok', percent: 7, resets_at: '2026-10-24T12:00:00Z' },
+    },
+  });
+  expect(windows.map(({ id, usedPercent }) => [id, usedPercent])).toEqual([
+    ['rolling', 12], ['weekly', 45], ['monthly', 7],
+  ]);
+  expect(windows[0].resetAtMs).toBe(Date.parse('2026-09-24T12:00:00Z'));
+});
+
+test('OpenCode Go quota requires a usable usage payload', () => {
+  expect(() => parseOpenCodeGoWindows({})).toThrow();
+  expect(() => parseOpenCodeGoWindows({ usage: { rolling: { percent: 0 } } })).toThrow();
+});
+
+test('OpenCode Go auth records are selected while disabled ones are excluded', () => {
+  const file = { name: 'opencode-go-key-abc.json', type: 'opencode-go', provider: 'opencode-go' };
+  expect(OPENCODE_GO_CONFIG.filterFn(file)).toBe(true);
+  expect(OPENCODE_GO_CONFIG.filterFn({ ...file, disabled: true })).toBe(false);
+});
