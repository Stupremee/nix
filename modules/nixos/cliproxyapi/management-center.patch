@@ -0,0 +1,69 @@
+import type { TFunction } from 'i18next';
+import type { AuthFileItem } from '@/types';
+import { apiClient } from '@/services/api/client';
+import { isDisabledAuthFile, resolveAuthProvider } from '@/utils/quota';
+import type { QuotaProviderData } from '../types';
+
+export type OpenCodeGoWindow = {
+  id: string;
+  labelKey: string;
+  usedPercent: number | null;
+  resetAtMs: number | null;
+  periodHours: number;
+  status: string;
+};
+
+export type OpenCodeGoQuotaState = {
+  status: 'idle' | 'loading' | 'success' | 'error';
+  windows: OpenCodeGoWindow[];
+  error?: string;
+  errorStatus?: number;
+};
+
+type QuotaWindowResponse = { status?: string; percent?: number; resets_at?: string };
+type QuotaResponse = {
+  usage?: { rolling?: QuotaWindowResponse; weekly?: QuotaWindowResponse; monthly?: QuotaWindowResponse };
+};
+
+export const parseOpenCodeGoWindows = (response: QuotaResponse): OpenCodeGoWindow[] => {
+  if (!response.usage) throw new Error('OpenCode Go returned no quota usage');
+  const periods = [
+    ['rolling', 5],
+    ['weekly', 168],
+    ['monthly', 720],
+  ] as const;
+  return periods.map(([id, periodHours]) => {
+    const window = response.usage?.[id];
+    if (!window || typeof window.percent !== 'number' || !Number.isFinite(window.percent)) {
+      throw new Error(`OpenCode Go returned invalid ${id} quota`);
+    }
+    const resetAtMs = window.resets_at ? Date.parse(window.resets_at) : NaN;
+    return {
+      id,
+      labelKey: `opencode_go_quota.${id}`,
+      usedPercent: window.percent,
+      resetAtMs: Number.isFinite(resetAtMs) ? resetAtMs : null,
+      periodHours,
+      status: window.status ?? '',
+    };
+  });
+};
+
+export const OPENCODE_GO_CONFIG: QuotaProviderData<OpenCodeGoQuotaState, OpenCodeGoWindow[]> = {
+  type: 'opencode-go',
+  i18nPrefix: 'opencode_go_quota',
+  filterFn: (file) => resolveAuthProvider(file) === 'opencode-go' && !isDisabledAuthFile(file),
+  fetchQuota: async (file: AuthFileItem, _t: TFunction) => {
+    const keyId = String(file.id || file.name.replace(/\.json$/, ''));
+    const response = await apiClient.post<QuotaResponse>(
+      '/plugins/opencode-go-cliproxyapi/quota-usage',
+      { key_id: keyId }
+    );
+    return parseOpenCodeGoWindows(response);
+  },
+  storeSelector: (state) => state.openCodeGoQuota,
+  storeSetter: 'setOpenCodeGoQuota',
+  buildLoadingState: () => ({ status: 'loading', windows: [] }),
+  buildSuccessState: (windows) => ({ status: 'success', windows }),
+  buildErrorState: (error, errorStatus) => ({ status: 'error', windows: [], error, errorStatus }),
+};
